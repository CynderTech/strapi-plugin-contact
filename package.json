{
  "name": "strapi-plugin-contact",
  "version": "1.0.0",
  "description": "Basic back-end functionality for a Contact Us form",
  "strapi": {
    "name": "Contact Us",
    "icon": "plug",
    "description": "Basic back-end functionality for a Contact Us form",
    "kind": "plugin"
  },
  "dependencies": {
    "@strapi/design-system": "^1.6.3",
    "@strapi/helper-plugin": "^4.6.0",
    "@strapi/icons": "^1.6.3",
    "@strapi/utils": "^4.13.6",
    "prop-types": "^15.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@buffetjs/core": "^3.3.4",
    "@buffetjs/custom": "^3.3.4",
    "@commitlint/cli": "^12.0.1",
    "@commitlint/config-conventional": "^12.0.1",
    "@strapi/typescript-utils": "^4.6.0",
    "@types/react": "^17.0.53",
    "@types/react-dom": "^18.0.28",
    "@types/react-router-dom": "^5.3.3",
    "@types/styled-components": "^5.1.26",
    "@typescript-eslint/eslint-plugin": "^6.7.2",
    "@typescript-eslint/parser": "^6.7.2",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^5.3.4",
    "styled-components": "^5.3.6",
    "typescript": "5.0.4"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^5.3.4",
    "styled-components": "^5.3.6"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged"
    }
  },
  "resolutions": {
    "@types/react": "17.0.14",
    "@types/react-dom": "17.0.14"
  },
  "lint-staged": {
    "*.{json,ts,tsx}": [
      "./node_modules/.bin/biome check --write"
    ]
  },
  "author": {
    "name": "Cyndertech",
    "email": "plugins@cynder.io",
    "url": "https://cynder.io"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CynderTech/strapi-plugin-contact-v4.git"
  },
  "bugs": {
    "url": "https://github.com/CynderTech/strapi-plugin-contact-v4/issues",
    "email": "plugins@cynder.io"
  },
  "maintainers": [
    {
      "name": "Cynder",
      "email": "hello@cynder.io",
      "url": "https://www.cynder.io"
    },
    {
      "name": "Sherman Joseph Sagun",
      "email": "sef@cynder.io"
    }
  ],
  "engines": {
    "node": ">=14.19.1 <=18.x.x",
    "npm": ">=6.0.0"
  },
  "scripts": {
    "lint": "biome lint",
    "develop": "tsc -p tsconfig.server.json -w",
    "build": "tsc -p tsconfig.server.json"
  },
  "license": "MIT"
}
